<?xml version="1.0"?>
<robot name="Two-axis arm">
  <link name="base">
    <inertial><mass value="3"/><inertia ixx=".05" ixy="0" ixz="0" iyy=".05" iyz="0" izz=".05"/></inertial>
    <visual><geometry><box size=".2 .2 .2"/></geometry></visual>
    <collision><geometry><box size=".2 .2 .2"/></geometry></collision>
  </link>
  <link name="upper">
    <inertial><origin xyz="0 0 .2"/><mass value="1"/><inertia ixx=".02" ixy="0" ixz="0" iyy=".02" iyz="0" izz=".005"/></inertial>
    <visual><origin xyz="0 0 .2"/><geometry><mesh filename="package://custom_robot/meshes/box.obj" scale=".1 .1 .4"/></geometry></visual>
    <collision><origin xyz="0 0 .2"/><geometry><box size=".1 .1 .4"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/><origin xyz="0 0 .1"/>
    <axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="40" velocity="4"/>
    <dynamics damping=".3"/>
  </joint>
  <link name="forearm">
    <inertial><origin xyz=".15 0 0"/><mass value=".6"/><inertia ixx=".003" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/></inertial>
    <visual><origin xyz=".15 0 0"/><geometry><box size=".3 .08 .08"/></geometry></visual>
    <collision><origin xyz=".15 0 0"/><geometry><box size=".3 .08 .08"/></geometry></collision>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="forearm"/><origin xyz="0 0 .4"/>
    <axis xyz="0 0 1"/><limit lower="-2" upper="2" effort="25" velocity="4"/>
    <dynamics damping=".2"/>
  </joint>
</robot>
